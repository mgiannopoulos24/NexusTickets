# Τι μένει εκτός του παραδοτέου zip.
#
# Το `git archive` (βλ. .github/workflows/submission.yml) παραλείπει ό,τι
# φέρει `export-ignore`. Τα παρακάτω αφορούν τη ροή ανάπτυξης, όχι την
# εργασία που παραδίδεται.

# Οδηγίες και skills για βοηθούς κώδικα.
AGENTS.md       export-ignore
.agents/        export-ignore
.claude/        export-ignore

# Εσωτερική λίστα εργασιών της ανάπτυξης.
TODO.md         export-ignore

# Ροές CI/CD — αφορούν το GitHub, όχι την παράδοση.
.github/workflows/  export-ignore

# Το ίδιο αυτό αρχείο δεν προσφέρει τίποτα σε όποιον διαβάζει τον κώδικα.
.gitattributes  export-ignore
