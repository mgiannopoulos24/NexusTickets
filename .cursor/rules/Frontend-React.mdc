## Redux Toolkit Rules
```typescript
// app/store.ts
import { configureStore } from '@reduxjs/toolkit';
import { authReducer } from '@/features/auth/authSlice';
import { eventsReducer } from '@/features/events/eventsSlice';
import { baseApi } from '@/lib/api';

export const store = configureStore({
  reducer: {
    auth: authReducer,
    events: eventsReducer,
    [baseApi.reducerPath]: baseApi.reducer,
  },
  middleware: (getDefaultMiddleware) =>
    getDefaultMiddleware().concat(baseApi.middleware),
});

export type RootState = ReturnType<typeof store.getState>;
export type AppDispatch = typeof store.dispatch;

// app/hooks.ts — ALWAYS use these, never raw useSelector/useDispatch
export const useAppDispatch = () => useDispatch<AppDispatch>();
export const useAppSelector: TypedUseSelectorHook<RootState> = useSelector;
```

## RTK Query Rules
```typescript
// lib/api.ts — single base API instance
import { createApi, fetchBaseQuery } from '@reduxjs/toolkit/query/react';
import type { RootState } from '@/app/store';

export const baseApi = createApi({
  reducerPath: 'api',
  baseQuery: fetchBaseQuery({
    baseUrl: import.meta.env.VITE_API_BASE_URL,
    prepareHeaders: (headers, { getState }) => {
      const token = (getState() as RootState).auth.accessToken;
      if (token) headers.set('Authorization', `Bearer ${token}`);
      return headers;
    },
  }),
  tagTypes: ['Event', 'Booking', 'User', 'Message'],
  endpoints: () => ({}),
});

// features/events/eventsApi.ts — inject endpoints
export const eventsApi = baseApi.injectEndpoints({
  endpoints: (build) => ({
    getEvents: build.query<ApiResponse<Event[]>, EventFilters>({
      query: (filters) => ({ url: '/events', params: filters }),
      providesTags: ['Event'],
    }),
    getEvent: build.query<ApiResponse<Event>, string>({
      query: (id) => `/events/${id}`,
      providesTags: (_result, _err, id) => [{ type: 'Event', id }],
    }),
    createEvent: build.mutation<ApiResponse<Event>, CreateEventRequest>({
      query: (body) => ({ url: '/events', method: 'POST', body }),
      invalidatesTags: ['Event'],
    }),
  }),
});

export const { useGetEventsQuery, useGetEventQuery, useCreateEventMutation } = eventsApi;
```

## React Router v7 Rules
```tsx
// routes/index.tsx
import { createBrowserRouter } from 'react-router';
import { AppShell } from '@/components/layout/AppShell';
import { ProtectedRoute } from './ProtectedRoute';

export const router = createBrowserRouter([
  {
    path: '/',
    element: <AppShell />,
    children: [
      { index: true, lazy: () => import('@/features/events/EventsPage') },
      { path: 'events/:id', lazy: () => import('@/features/events/EventDetailPage') },
      {
        path: 'bookings',
        element: <ProtectedRoute roles={['attendee', 'organizer']} />,
        children: [
          { index: true, lazy: () => import('@/features/bookings/MyBookingsPage') },
        ],
      },
      {
        path: 'organizer',
        element: <ProtectedRoute roles={['organizer']} />,
        children: [
          { index: true, lazy: () => import('@/features/organizer/OrganizerEventsPage') },
          { path: 'events/new', lazy: () => import('@/features/organizer/CreateEventPage') },
          { path: 'events/:id/edit', lazy: () => import('@/features/organizer/EditEventPage') },
        ],
      },
      {
        path: 'admin',
        element: <ProtectedRoute roles={['admin']} />,
        children: [
          { index: true, lazy: () => import('@/features/admin/UsersPage') },
          { path: 'users/:id', lazy: () => import('@/features/admin/UserDetailPage') },
        ],
      },
      {
        path: 'messages',
        element: <ProtectedRoute roles={['attendee', 'organizer']} />,
        children: [
          { index: true, lazy: () => import('@/features/messaging/InboxPage') },
          { path: 'sent', lazy: () => import('@/features/messaging/SentPage') },
        ],
      },
    ],
  },
  { path: '/login', lazy: () => import('@/features/auth/LoginPage') },
  { path: '/register', lazy: () => import('@/features/auth/RegisterPage') },
  { path: '/pending', lazy: () => import('@/features/auth/PendingApprovalPage') },
  { path: '/unauthorized', lazy: () => import('@/pages/UnauthorizedPage') },
]);

// routes/ProtectedRoute.tsx
export function ProtectedRoute({ roles }: { roles: UserRole[] }) {
  const { user, isAuthenticated } = useAuth();
  if (!isAuthenticated) return <Navigate to="/login" replace />;
  if (!roles.includes(user.role)) return <Navigate to="/unauthorized" replace />;
  return <Outlet />;
}
```

## React Hook Form + Zod
```tsx
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';

const loginSchema = z.object({
  username: z.string().min(1, 'Υποχρεωτικό πεδίο'),
  password: z.string().min(6, 'Τουλάχιστον 6 χαρακτήρες'),
});
type LoginFormData = z.infer<typeof loginSchema>;

export function LoginPage() {
  const { register, handleSubmit, formState: { errors, isSubmitting } } = useForm<LoginFormData>({
    resolver: zodResolver(loginSchema),
  });

  const onSubmit = async (data: LoginFormData) => { ... };

  return (
    <form onSubmit={handleSubmit(onSubmit)}>
      <input {...register('username')} />
      {errors.username && <p>{errors.username.message}</p>}
      <button type="submit" disabled={isSubmitting}>Σύνδεση</button>
    </form>
  );
}
```

## shadcn/ui Rules
- Components live in `src/components/ui/` — generated by `bunx shadcn add <component>`
- Never manually edit files in `src/components/ui/` — re-generate instead
- Always use shadcn components for: Button, Input, Card, Dialog, Table, Badge, Tabs, Sheet, Toast, Select, Popover, Calendar
- Compose shadcn primitives into feature-specific components in `src/components/shared/`

```tsx
// Good — compose shadcn into feature component
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { MapPin, Calendar } from 'lucide-react';

export function EventCard({ event }: { event: Event }) {
  return (
    <Card className="hover:shadow-lg transition-shadow">
      <CardHeader>
        <CardTitle>{event.title}</CardTitle>
        <Badge variant={event.status === 'published' ? 'default' : 'secondary'}>
          {event.status}
        </Badge>
      </CardHeader>
      <CardContent className="space-y-2">
        <div className="flex items-center gap-2 text-sm text-muted-foreground">
          <MapPin className="w-4 h-4" />
          <span>{event.venue}, {event.city}</span>
        </div>
        <div className="flex items-center gap-2 text-sm text-muted-foreground">
          <Calendar className="w-4 h-4" />
          <span>{formatDate(event.startAt)}</span>
        </div>
      </CardContent>
    </Card>
  );
}
```

