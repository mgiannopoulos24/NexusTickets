## TypeScript Rules
- `"strict": true` in `tsconfig.json`
- No `any` — use `unknown` with type guards
- Enums as `as const` objects:
```typescript
export const EventStatus = {
  DRAFT: 'DRAFT',
  PUBLISHED: 'PUBLISHED',
  COMPLETED: 'COMPLETED',
  CANCELLED: 'CANCELLED',
} as const;
export type EventStatus = typeof EventStatus[keyof typeof EventStatus];
```

## WebSocket Client (Requirement 10)

### Message Types
```typescript
// types/ws.ts
export const WSMessageType = {
  NEW_MESSAGE:   'new_message',
  DELETED:       'message_deleted',
  UNREAD_COUNT:  'unread_count',
  ERROR:         'error',
} as const;
export type WSMessageType = typeof WSMessageType[keyof typeof WSMessageType];

export interface WSEnvelope {
  type: WSMessageType;
  payload: unknown;
}

export interface WSNewMessagePayload {
  id: string;
  senderId: string;
  senderName: string;
  subject: string;
  body: string;
  eventId: string | null;
  sentAt: string;
}

export interface WSUnreadCountPayload {
  count: number;
}
```

### WS Client Singleton
```typescript
// lib/wsClient.ts
const WS_URL = import.meta.env.VITE_WS_URL; // ws://localhost:8080/api/v1/ws/messages

type MessageHandler = (envelope: WSEnvelope) => void;

class WebSocketClient {
  private ws: WebSocket | null = null;
  private handlers = new Set<MessageHandler>();
  private reconnectTimer: ReturnType<typeof setTimeout> | null = null;
  private token: string | null = null;

  connect(token: string) {
    this.token = token;
    this.ws = new WebSocket(`${WS_URL}?token=${token}`);

    this.ws.onmessage = (event) => {
      try {
        const envelope: WSEnvelope = JSON.parse(event.data);
        this.handlers.forEach(h => h(envelope));
      } catch { /* ignore malformed */ }
    };

    this.ws.onclose = () => {
      // reconnect with exponential backoff
      this.reconnectTimer = setTimeout(() => {
        if (this.token) this.connect(this.token);
      }, 3000);
    };

    this.ws.onerror = () => this.ws?.close();
  }

  disconnect() {
    this.token = null;
    if (this.reconnectTimer) clearTimeout(this.reconnectTimer);
    this.ws?.close();
    this.ws = null;
  }

  subscribe(handler: MessageHandler) {
    this.handlers.add(handler);
    return () => this.handlers.delete(handler);
  }
}

export const wsClient = new WebSocketClient();
```

### useWebSocket Hook
```typescript
// hooks/useWebSocket.ts
export function useWebSocket() {
  const dispatch = useAppDispatch();
  const { accessToken, isAuthenticated } = useAuth();

  useEffect(() => {
    if (!isAuthenticated || !accessToken) return;

    wsClient.connect(accessToken);

    const unsubscribe = wsClient.subscribe((envelope) => {
      switch (envelope.type) {
        case WSMessageType.NEW_MESSAGE:
          dispatch(messagingSlice.actions.addIncomingMessage(
            envelope.payload as WSNewMessagePayload
          ));
          break;
        case WSMessageType.UNREAD_COUNT:
          dispatch(messagingSlice.actions.setUnreadCount(
            (envelope.payload as WSUnreadCountPayload).count
          ));
          break;
        case WSMessageType.DELETED:
          // invalidate RTK Query cache
          dispatch(baseApi.util.invalidateTags(['Message']));
          break;
      }
    });

    return () => {
      unsubscribe();
      wsClient.disconnect();
    };
  }, [isAuthenticated, accessToken]);
}
```

### Where to Mount the Hook
```tsx
// components/layout/AppShell.tsx
export function AppShell() {
  useWebSocket(); // single mount point — runs for entire session

  return (
    <>
      <Navbar />
      <main>
        <Outlet />
      </main>
    </>
  );
}
```

### messagingSlice
```typescript
// features/messaging/messagingSlice.ts
interface MessagingState {
  unreadCount: number;
  pendingMessages: WSNewMessagePayload[]; // buffered until inbox is opened
}

const messagingSlice = createSlice({
  name: 'messaging',
  initialState: { unreadCount: 0, pendingMessages: [] } as MessagingState,
  reducers: {
    setUnreadCount: (state, action: PayloadAction<number>) => {
      state.unreadCount = action.payload;
    },
    addIncomingMessage: (state, action: PayloadAction<WSNewMessagePayload>) => {
      state.unreadCount += 1;
      state.pendingMessages.push(action.payload);
    },
    clearPending: (state) => {
      state.pendingMessages = [];
    },
  },
});
```

