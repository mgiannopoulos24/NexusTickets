## Auth Slice
```typescript
// features/auth/authSlice.ts
interface AuthState {
  user: User | null;
  accessToken: string | null;
  refreshToken: string | null;
  isAuthenticated: boolean;
}

const authSlice = createSlice({
  name: 'auth',
  initialState: loadFromStorage(), // rehydrate from localStorage on init
  reducers: {
    setCredentials: (state, action: PayloadAction<LoginResponse>) => {
      state.user = action.payload.user;
      state.accessToken = action.payload.accessToken;
      state.isAuthenticated = true;
      localStorage.setItem('auth', JSON.stringify(state));
    },
    logout: (state) => {
      state.user = null;
      state.accessToken = null;
      state.isAuthenticated = false;
      localStorage.removeItem('auth');
    },
  },
});
```

## Token Refresh (RTK Query baseQuery wrapper)
```typescript
// lib/api.ts — handle 401 and refresh automatically
const baseQueryWithReauth: BaseQueryFn = async (args, api, extraOptions) => {
  let result = await baseQuery(args, api, extraOptions);
  if (result.error?.status === 401) {
    const refreshResult = await baseQuery('/auth/refresh', api, extraOptions);
    if (refreshResult.data) {
      api.dispatch(setCredentials(refreshResult.data as LoginResponse));
      result = await baseQuery(args, api, extraOptions);
    } else {
      api.dispatch(logout());
    }
  }
  return result;
};
```

## Tailwind v4 Rules
- No `tailwind.config.js` — configure in CSS with `@theme`
- CSS variables for design tokens:
```css
/* src/index.css */
@import "tailwindcss";

@theme {
  --color-primary: oklch(0.5 0.2 250);
  --color-background: oklch(1 0 0);
  --color-foreground: oklch(0.1 0 0);
  --color-muted-foreground: oklch(0.5 0 0);
}
```
- Use `cn()` utility (from `clsx` + `tailwind-merge`) for conditional classes:
```typescript
// lib/utils.ts
import { clsx, type ClassValue } from 'clsx';
import { twMerge } from 'tailwind-merge';
export function cn(...inputs: ClassValue[]) { return twMerge(clsx(inputs)); }
```

## Data Fetching Patterns
```tsx
// GOOD — RTK Query with all states handled
export function EventsPage() {
  const [filters, setFilters] = useState<EventFilters>({});
  const { data, isLoading, isError, error } = useGetEventsQuery(filters);

  if (isLoading) return <SkeletonList />;
  if (isError) return <ErrorMessage error={error} />;
  if (!data?.data.length) return <EmptyState message="Δεν βρέθηκαν εκδηλώσεις" />;

  return (
    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {data.data.map(event => (
        <EventCard key={event.id} event={event} />
      ))}
    </div>
  );
}
```

## OpenStreetMap (Requirement 9)
- Use `react-leaflet` + `leaflet`
- Lazy load the map component — it's heavy
- Always set explicit height on container before mounting
```tsx
const MapEmbed = lazy(() => import('@/components/shared/MapEmbed'));

// In EventDetailPage:
<Suspense fallback={<div className="h-64 bg-muted animate-pulse rounded-lg" />}>
  <MapEmbed lat={event.latitude} lng={event.longitude} title={event.venue} />
</Suspense>
```

## Performance Rules
- All route-level components lazy loaded via `lazy()` or React Router's `lazy`
- `React.memo` for expensive list items (EventCard in large lists)
- `useMemo` / `useCallback` only when profiling shows a real problem — not preemptively
- Images: use explicit `width` and `height` to avoid layout shift

