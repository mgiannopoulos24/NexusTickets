# Copy to ".env" and adjust for your machine.
# Never commit real secrets or prod credentials.

# ---- Postgres ----
POSTGRES_DB=nexustickets
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change_me
POSTGRES_EXPOSED_PORT=5432

# ---- Redis ----
REDIS_PASSWORD=change_me
REDIS_EXPOSED_PORT=6379

# ---- Backend ----
APP_PORT=8080

# These are placeholders for the upcoming DB/Redis config in the Go service.
# Compose defaults will set these to the correct container hostnames.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nexustickets
DB_USER=nexus
DB_PASSWORD=change_me

REDIS_HOST=redis
REDIS_PORT=6379

# ---- Frontend ----
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

