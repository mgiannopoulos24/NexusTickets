# Copy to ".env" and adjust for your machine.
# Never commit real secrets or prod credentials.

# ---- Postgres ----
POSTGRES_DB=nexustickets
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change_me
POSTGRES_EXPOSED_PORT=5432

# Dedicated application role (recommended: non-superuser)
POSTGRES_APP_DB=nexustickets
POSTGRES_APP_USER=nexustickets_app
POSTGRES_APP_PASSWORD=change_me

# ---- Redis ----
REDIS_PASSWORD=change_me
REDIS_EXPOSED_PORT=6379

# ---- Backend ----
# Docker Compose (dev overlay): set to `id -u` / `id -g` on Linux so the backend process can
# write under the bind-mounted ./backend (e.g. uploads/media). Defaults 1000:1000.
HOST_UID=1000
HOST_GID=1000

APP_PORT=8080
APP_ENV=development

# Optional TLS (both must be set). Docker Compose mounts `docker/tls/local` and defaults to:
#   TLS_CERT_FILE=/etc/tls/cert.pem  TLS_KEY_FILE=/etc/tls/key.pem
# Generate with: make local-tls
# For `air` / `go run` from `backend/`, use paths such as:
# TLS_CERT_FILE=../docker/tls/local/cert.pem
# TLS_KEY_FILE=../docker/tls/local/key.pem

# Comma-separated list (no spaces).
# - http://localhost        (nginx / docker frontend on port 80)
# - http://localhost:5173   (Vite dev server, plain HTTP)
# - https://localhost       (nginx / docker frontend on port 443)
# - https://localhost:5173  (Vite dev server with mkcert / TLS)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,https://localhost,https://localhost:5173
JWT_SECRET=change_me_super_secret
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW=1m
MEDIA_STORAGE_PATH=./uploads/media

# These are placeholders for the upcoming DB/Redis config in the Go service.
# Compose defaults will set these to the correct container hostnames.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nexustickets
DB_USER=nexustickets_app
DB_PASSWORD=change_me

REDIS_HOST=redis
REDIS_PORT=6379

# ---- Frontend ----
FRONTEND_PORT=5173
FRONTEND_HTTP_PORT=3000
# VITE_API_PROXY_TARGET=https://127.0.0.1:8080
# # Leave empty so the client derives wss://<page host>/api/v1/ws/messages and
# goes through the dev proxy. A hard-coded ws:// URL is blocked as mixed
# content on an https page, which silently kills real-time messaging.
VITE_WS_URL=

# ---- External APIs ----
VITE_GIPHY_API_KEY=your_giphy_api_key_here

